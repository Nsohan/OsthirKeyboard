<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_grid_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorKeyboard"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="42dp"
    android:gravity="top|center_horizontal">

  <!-- Swipeable paged container: 4 items max per page (2 columns x 2 rows) -->
  <androidx.viewpager2.widget.ViewPager2
      android:id="@+id/menu_view_pager"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:overScrollMode="never"/>

  <!-- Bottom action bar: pagination dots in center, edit button on right -->
  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="26dp"
      android:gravity="center_vertical">

    <!-- Dots centered -->
    <LinearLayout
        android:id="@+id/menu_dots_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="horizontal"
        android:gravity="center"/>

    <!-- Edit button on right -->
    <FrameLayout
        android:id="@+id/menu_btn_edit"
        android:layout_width="48dp"
        android:layout_height="26dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_menu_edit_pill"
        android:clickable="true"
        android:focusable="true">

      <ImageView
          android:id="@+id/menu_btn_edit_icon"
          android:layout_width="15dp"
          android:layout_height="15dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_edit_pencil"
          android:tint="?attr/colorKeyAction"/>
    </FrameLayout>
  </RelativeLayout>
</LinearLayout>
