<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background"
    android:orientation="vertical">

    <!-- App Toolbar using the app's default Settings theme -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/layout_editor_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/settings_background"
        app:title="Custom Layout"
        app:subtitle="Osthir Keyboard Engine"
        app:titleTextColor="@color/settings_on_surface"
        app:subtitleTextColor="@color/settings_on_surface_variant"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/settings_on_surface"
        app:contentInsetStart="20dp"
        app:contentInsetStartWithNavigation="16dp"
        android:elevation="0dp" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_editor_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Section 1: Keyboard Parameters (Ultra-Compact) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.05"
                android:text="KEYBOARD PARAMETERS"
                android:textColor="@color/settings_on_surface_variant"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/card_parameters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_settings_card"
                android:elevation="0dp"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <!-- Row 1: Name and Keymap side-by-side -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Layout Name (Left) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1.15"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_settings_card"
                        android:backgroundTint="@color/settings_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp">

                        <EditText
                            android:id="@+id/layout_editor_name_input"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Layout name"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/settings_on_surface"
                            android:textColorHint="@color/settings_on_surface_variant"
                            android:textSize="12.5sp" />

                        <ImageButton
                            android:id="@+id/layout_editor_name_clear_btn"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="2dp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="@color/settings_icon_tint" />
                    </LinearLayout>

                    <!-- Keymap Spinner (Right) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="0.85"
                        android:background="@drawable/bg_settings_card"
                        android:backgroundTint="@color/settings_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <Spinner
                            android:id="@+id/layout_editor_keymap_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Compact Swipe Keymap Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Swipe keymap gestures (8-dir)"
                        android:textColor="@color/settings_on_surface"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/layout_editor_swipekeymap_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 2: Live Visual Deck (Actual keyboard size & placement) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.05"
                    android:text="LIVE KEYBOARD PREVIEW"
                    android:textColor="@color/settings_on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/visual_deck_row_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live"
                    android:textColor="@color/settings_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Keyboard Deck Card: Full width, actual keyboard layout placement -->
            <FrameLayout
                android:id="@+id/card_visual_deck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_settings_card"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:elevation="0dp"
                android:padding="0dp">

                <FrameLayout
                    android:id="@+id/visual_deck_preview_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <!-- Section 3: XML Code Editor -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.05"
                android:text="LAYOUT XML CODE"
                android:textColor="@color/settings_on_surface_variant"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/card_code_editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_settings_card"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header row inside card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/layout_file_name_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="layout.xml"
                        android:textColor="@color/settings_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/layout_editor_btn_copy"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="56dp"
                        android:text="📋 Copy"
                        android:textColor="@color/settings_primary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/layout_editor_btn_format"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="56dp"
                        android:text="✨ Format"
                        android:textColor="@color/settings_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Quick chips bar -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_editor_quick_chips_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Editor wrapper -->
                <LinearLayout
                    android:id="@+id/layout_editor_input_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_card"
                    android:backgroundTint="@color/settings_background"
                    android:orientation="vertical"
                    android:padding="4dp" />

                <!-- Error message view -->
                <TextView
                    android:id="@+id/layout_editor_error_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/settings_error"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/layout_editor_btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:backgroundTint="@color/settings_primary"
                android:textColor="@color/settings_on_primary"
                app:cornerRadius="24dp"
                android:text="Save Layout"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Remove Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/layout_editor_btn_remove"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="44dp"
                android:text="Remove this layout"
                android:textColor="@color/settings_error"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
