<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/action_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/action_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/settings_background"
        app:title="@string/tasker_plugin_action_title"
        app:titleTextColor="@color/settings_on_surface"
        app:navigationIconTint="@color/settings_on_surface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:contentInsetStart="20dp"
        app:contentInsetStartWithNavigation="16dp"
        android:elevation="0dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="@string/tasker_plugin_action_subtitle"
        android:textColor="@color/settings_on_surface_variant"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/action_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <!-- Configuration Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tasker_plugin_field_result_text"
                    android:textColor="@color/settings_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_result_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_input_box"
                    android:hint="@string/tasker_plugin_field_result_text_hint"
                    android:textColor="@color/settings_on_surface"
                    android:textColorHint="@color/settings_on_surface_variant"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:gravity="top|start"
                    android:padding="12dp"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/tasker_plugin_chips_label"
                    android:textColor="@color/settings_on_surface_variant"
                    android:textSize="12sp" />

                <!-- Variable Quick Chips -->
                <HorizontalScrollView
                    android:id="@+id/chips_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/chips_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_result"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center"
                            android:background="@drawable/bg_settings_chip"
                            android:text="%result"
                            android:textColor="@color/settings_primary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/chip_requestid"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center"
                            android:background="@drawable/bg_settings_chip"
                            android:text="%nhck_requestid"
                            android:textColor="@color/settings_primary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/chip_keyword"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center"
                            android:background="@drawable/bg_settings_chip"
                            android:text="%nhck_keyword"
                            android:textColor="@color/settings_primary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/chip_text1"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center"
                            android:background="@drawable/bg_settings_chip"
                            android:text="%nhck_text1"
                            android:textColor="@color/settings_primary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true" />

                        <TextView
                            android:id="@+id/chip_clip"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center"
                            android:background="@drawable/bg_settings_chip"
                            android:text="%CLIP"
                            android:textColor="@color/settings_primary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true" />

                    </LinearLayout>
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/settings_divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tasker_plugin_field_request_id"
                    android:textColor="@color/settings_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_request_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_input_box"
                    android:hint="@string/tasker_plugin_field_request_id_hint"
                    android:textColor="@color/settings_on_surface"
                    android:textColorHint="@color/settings_on_surface_variant"
                    android:inputType="textNoSuggestions"
                    android:padding="12dp"
                    android:text="%nhck_requestid"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tasker_plugin_field_request_id_help"
                    android:textColor="@color/settings_on_surface_variant"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- Explanatory Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_settings_card"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tasker_plugin_card_info_title"
                    android:textColor="@color/settings_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tasker_plugin_card_info_body"
                    android:textColor="@color/settings_on_surface_variant"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"
        android:backgroundTint="@color/settings_primary"
        android:textColor="@color/settings_on_primary"
        app:cornerRadius="24dp"
        android:text="@string/tasker_plugin_save"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
