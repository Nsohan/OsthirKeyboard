<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_typing_bar"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

  <!-- Close button [ ✕ ] -->
  <ImageButton
      android:id="@+id/btn_voice_back"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="@drawable/bg_circle_button"
      android:src="@drawable/ic_close"
      android:scaleType="fitCenter"
      android:padding="8dp"
      android:tint="?attr/colorLabel"
      android:contentDescription="@android:string/cancel"/>

  <!-- Centered Status Text (e.g. "Speak now" or "এখনই বলুন") -->
  <TextView
      android:id="@+id/tv_voice_status"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:text="Speak now"
      android:textColor="?attr/colorLabel"
      android:textSize="16sp"
      android:singleLine="true"
      android:ellipsize="end"/>

  <!-- Language Badge Pill [ EN ] or [ BN ] -->
  <TextView
      android:id="@+id/tv_voice_lang_badge"
      android:layout_width="wrap_content"
      android:layout_height="22dp"
      android:minWidth="26dp"
      android:background="@drawable/bg_voice_lang_badge"
      android:gravity="center"
      android:text="EN"
      android:textColor="#3D2005"
      android:textSize="11sp"
      android:textStyle="bold"
      android:paddingStart="7dp"
      android:paddingEnd="7dp"
      android:layout_marginStart="6dp"
      android:layout_marginEnd="6dp"
      android:clickable="true"
      android:focusable="true"/>

  <!-- Active Mic Button (🎤) -->
  <ImageButton
      android:id="@+id/btn_voice_mic"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:background="@drawable/bg_voice_mic_active"
      android:src="@drawable/ic_mic"
      android:scaleType="fitCenter"
      android:padding="6dp"
      android:tint="#FFFFFF"
      android:contentDescription="@string/key_descr_voice_typing"/>

</LinearLayout>
