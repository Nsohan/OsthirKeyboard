<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_background">

  <!-- Top App Bar / Toolbar -->
  <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/launcher_toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="@color/settings_background"
      app:title="@string/app_name"
      app:titleTextColor="@color/settings_on_surface"
      app:contentInsetStart="16dp"
      android:elevation="0dp" />

  <!-- Step Progress Header -->
  <LinearLayout
      android:id="@+id/layout_progress_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="20dp"
      android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <TextView
          android:id="@+id/tv_step_counter"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Step 1 of 6"
          android:textColor="@color/settings_primary"
          android:textSize="13sp"
          android:fontFamily="sans-serif-medium"
          android:letterSpacing="0.04" />

      <TextView
          android:id="@+id/btn_header_skip"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/onboarding_btn_skip"
          android:textColor="@color/settings_on_surface_variant"
          android:textSize="13sp"
          android:fontFamily="sans-serif-medium"
          android:background="?attr/selectableItemBackground"
          android:paddingVertical="4dp"
          android:paddingHorizontal="8dp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:trackColor="@color/settings_divider"
        app:indicatorColor="@color/settings_primary"
        app:trackCornerRadius="4dp"
        app:trackThickness="4dp"
        android:max="100"
        android:progress="16" />
  </LinearLayout>

  <androidx.core.widget.NestedScrollView
      android:id="@+id/launcher_scroll_view"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

      <!-- Step ViewFlipper containing the 6 step cards -->
      <ViewFlipper
          android:id="@+id/step_flipper"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

        <!-- STEP 0: Enable Keyboard -->
        <LinearLayout
            android:id="@+id/step_enable_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:background="@drawable/bg_settings_card"
              android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_enable_title"
                android:textColor="@color/settings_on_surface"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_step_enable_desc"
                android:textColor="@color/settings_on_surface_variant"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- Status Indicator Row -->
            <LinearLayout
                android:id="@+id/badge_enable_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_badge_inactive"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

              <ImageView
                  android:id="@+id/iv_enable_status"
                  android:layout_width="16dp"
                  android:layout_height="16dp"
                  android:src="@drawable/ic_info_outline"
                  app:tint="@color/settings_on_surface_variant" />

              <TextView
                  android:id="@+id/tv_enable_status"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:text="@string/onboarding_status_disabled"
                  android:textColor="@color/settings_on_surface_variant"
                  android:textSize="13sp"
                  android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_marginTop="20dp"
                android:text="@string/onboarding_btn_enable"
                android:textColor="@color/settings_on_primary"
                app:backgroundTint="@color/settings_primary"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                app:icon="@drawable/ic_tune"
                app:iconTint="@color/settings_on_primary"
                app:iconGravity="textStart" />

          </LinearLayout>

          <!-- Bottom Navigation for Step 0 -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="16dp"
              android:orientation="horizontal"
              android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step0_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_btn_next"
                android:textColor="@color/settings_on_primary"
                app:backgroundTint="@color/settings_primary"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textEnd"
                app:iconTint="@color/settings_on_primary" />
          </LinearLayout>

        </LinearLayout>

        <!-- STEP 1: Select Keyboard -->
        <LinearLayout
            android:id="@+id/step_select_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:background="@drawable/bg_settings_card"
              android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_select_title"
                android:textColor="@color/settings_on_surface"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_step_select_desc"
                android:textColor="@color/settings_on_surface_variant"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- Status Indicator Row -->
            <LinearLayout
                android:id="@+id/badge_select_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_badge_inactive"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

              <ImageView
                  android:id="@+id/iv_select_status"
                  android:layout_width="16dp"
                  android:layout_height="16dp"
                  android:src="@drawable/ic_info_outline"
                  app:tint="@color/settings_on_surface_variant" />

              <TextView
                  android:id="@+id/tv_select_status"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:text="@string/onboarding_status_not_selected"
                  android:textColor="@color/settings_on_surface_variant"
                  android:textSize="13sp"
                  android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_marginTop="20dp"
                android:text="@string/onboarding_btn_select"
                android:textColor="@color/settings_on_primary"
                app:backgroundTint="@color/settings_primary"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                app:icon="@drawable/ic_keyboard"
                app:iconTint="@color/settings_on_primary"
                app:iconGravity="textStart" />

          </LinearLayout>

          <!-- Bottom Navigation for Step 1 -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="16dp"
              android:orientation="horizontal"
              android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step1_back"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_btn_back"
                android:textColor="@color/settings_primary"
                app:strokeColor="@color/settings_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/settings_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step1_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_btn_next"
                android:textColor="@color/settings_on_primary"
                app:backgroundTint="@color/settings_primary"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textEnd"
                app:iconTint="@color/settings_on_primary" />
          </LinearLayout>

        </LinearLayout>

        <!-- STEP 2: Swipe Gesture Tutorial & Playground -->
        <LinearLayout
            android:id="@+id/step_swipe_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:background="@drawable/bg_settings_card"
              android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_swipe_title"
                android:textColor="@color/settings_on_surface"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_step_swipe_desc"
                android:textColor="@color/settings_on_surface_variant"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- Animation Demo Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_settings_input_box"
                android:layout_marginTop="16dp"
                android:paddingVertical="14dp">

              <ImageView
                  android:id="@+id/anim_swipe_view"
                  style="@style/anim"
                  android:background="@drawable/doc_key_u"
                  android:src="@drawable/doc_anim_swipe" />

              <TextView
                  style="@style/anim_text"
                  android:text="@string/launcher_anim_7" />
            </LinearLayout>

            <!-- Live Playground Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/onboarding_playground_label"
                android:textColor="@color/settings_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/et_playground_swipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="6dp"
                android:inputType="text"
                android:hint="@string/onboarding_playground_hint_swipe"
                android:textColor="@color/settings_on_surface"
                android:textColorHint="@color/settings_on_surface_variant"
                android:background="@drawable/bg_settings_input_box"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textSize="14sp"
                android:importantForAutofill="no" />

          </LinearLayout>

          <!-- Bottom Navigation for Step 2 -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="16dp"
              android:orientation="horizontal"
              android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step2_back"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_btn_back"
                android:textColor="@color/settings_primary"
                app:strokeColor="@color/settings_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/settings_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step2_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_btn_next"
                android:textColor="@color/settings_on_primary"
                app:backgroundTint="@color/settings_primary"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textEnd"
                app:iconTint="@color/settings_on_primary" />
          </LinearLayout>

        </LinearLayout>

        <!-- STEP 3: Circle Gesture Tutorial & Playground -->
        <LinearLayout
            android:id="@+id/step_circle_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:background="@drawable/bg_settings_card"
              android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_circle_title"
                android:textColor="@color/settings_on_surface"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_step_circle_desc"
                android:textColor="@color/settings_on_surface_variant"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- Animation Demo Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_settings_input_box"
                android:layout_marginTop="16dp"
                android:paddingVertical="14dp">

              <ImageView
                  android:id="@+id/anim_circle_view"
                  style="@style/anim"
                  android:background="@drawable/doc_key_u"
                  android:src="@drawable/doc_anim_circle" />

              <TextView
                  style="@style/anim_text"
                  android:text="@string/launcher_anim_g" />
            </LinearLayout>

            <!-- Live Playground Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/onboarding_playground_label"
                android:textColor="@color/settings_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/et_playground_circle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="6dp"
                android:inputType="text"
                android:hint="@string/onboarding_playground_hint_circle"
                android:textColor="@color/settings_on_surface"
                android:textColorHint="@color/settings_on_surface_variant"
                android:background="@drawable/bg_settings_input_box"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textSize="14sp"
                android:importantForAutofill="no" />

          </LinearLayout>

          <!-- Bottom Navigation for Step 3 -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="16dp"
              android:orientation="horizontal"
              android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step3_back"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_btn_back"
                android:textColor="@color/settings_primary"
                app:strokeColor="@color/settings_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/settings_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step3_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_btn_next"
                android:textColor="@color/settings_on_primary"
                app:backgroundTint="@color/settings_primary"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textEnd"
                app:iconTint="@color/settings_on_primary" />
          </LinearLayout>

        </LinearLayout>

        <!-- STEP 4: Slide & Return Tutorial & Playground -->
        <LinearLayout
            android:id="@+id/step_roundtrip_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:background="@drawable/bg_settings_card"
              android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step_roundtrip_title"
                android:textColor="@color/settings_on_surface"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_step_roundtrip_desc"
                android:textColor="@color/settings_on_surface_variant"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- Animation Demo Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_settings_input_box"
                android:layout_marginTop="16dp"
                android:paddingVertical="14dp">

              <ImageView
                  android:id="@+id/anim_roundtrip_view"
                  style="@style/anim"
                  android:background="@drawable/doc_key_g"
                  android:src="@drawable/doc_anim_round_trip" />

              <TextView
                  style="@style/anim_text"
                  android:text="@string/launcher_anim_dash" />
            </LinearLayout>

            <!-- Live Playground Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/onboarding_playground_label"
                android:textColor="@color/settings_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/et_playground_roundtrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="6dp"
                android:inputType="text"
                android:hint="@string/onboarding_playground_hint_roundtrip"
                android:textColor="@color/settings_on_surface"
                android:textColorHint="@color/settings_on_surface_variant"
                android:background="@drawable/bg_settings_input_box"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textSize="14sp"
                android:importantForAutofill="no" />

          </LinearLayout>

          <!-- Bottom Navigation for Step 4 -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="16dp"
              android:orientation="horizontal"
              android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step4_back"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_btn_back"
                android:textColor="@color/settings_primary"
                app:strokeColor="@color/settings_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/settings_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step4_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_btn_next"
                android:textColor="@color/settings_on_primary"
                app:backgroundTint="@color/settings_primary"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textEnd"
                app:iconTint="@color/settings_on_primary" />
          </LinearLayout>

        </LinearLayout>

        <!-- STEP 5: All Set / Ready -->
        <LinearLayout
            android:id="@+id/step_done_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:gravity="center_horizontal"
              android:background="@drawable/bg_settings_card"
              android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_check"
                app:tint="@color/settings_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/onboarding_step_done_title"
                android:textColor="@color/settings_on_surface"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_step_done_desc"
                android:textColor="@color/settings_on_surface_variant"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textAlignment="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step_dictionaries"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/launcher_button_dictionaries"
                android:textColor="@color/settings_primary"
                app:strokeColor="@color/settings_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_menu_book"
                app:iconTint="@color/settings_primary"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step_finish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:layout_marginTop="12dp"
                android:text="@string/onboarding_btn_finish"
                android:textColor="@color/settings_on_primary"
                app:backgroundTint="@color/settings_primary"
                app:cornerRadius="12dp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                app:icon="@drawable/ic_check"
                app:iconTint="@color/settings_on_primary"
                app:iconGravity="textStart" />

          </LinearLayout>

          <!-- Bottom Navigation for Step 5 -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="16dp"
              android:orientation="horizontal"
              android:gravity="start">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step5_back"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:minHeight="48dp"
                android:text="@string/onboarding_btn_back"
                android:textColor="@color/settings_primary"
                app:strokeColor="@color/settings_primary"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/settings_primary" />
          </LinearLayout>

        </LinearLayout>

      </ViewFlipper>

      <!-- Source Code Footer (Subtle) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:orientation="vertical"
          android:gravity="center_horizontal"
          android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/launcher_sourcecode"
            android:textColor="@color/settings_on_surface_variant"
            android:textSize="12sp"
            android:textAlignment="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/launcher_repo_url"
            android:textColorLink="@color/settings_primary"
            android:textColor="@color/settings_primary"
            android:textSize="12sp"
            android:textAlignment="center"
            android:autoLink="web"
            android:linksClickable="true" />

      </LinearLayout>

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

</LinearLayout>
