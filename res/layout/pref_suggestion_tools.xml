<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

  <!-- Category Header: Tools Appearance -->
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/pref_category_tools_appearance"
      android:textSize="13sp"
      android:textStyle="bold"
      android:textColor="?attr/colorAccent"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:layout_marginBottom="8dp"/>

  <!-- Appearance Card with Inline Sliders -->
  <androidx.cardview.widget.CardView
      android:id="@+id/card_tools_appearance"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:cardCornerRadius="20dp"
      app:cardElevation="0dp"
      app:cardBackgroundColor="@color/settings_card_bg"
      android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- Icon Size Row -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_lable_size"
            android:tint="?android:attr/textColorSecondary"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pref_suggestion_tool_icon_size_title"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"/>

        <TextView
            android:id="@+id/tv_icon_size_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorAccent"/>
      </LinearLayout>

      <!-- Icon Size SeekBar (50% to 150%) -->
      <SeekBar
          android:id="@+id/seekbar_icon_size"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="4dp"
          android:max="100"
          android:progress="50"/>

      <!-- Divider -->
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@color/settings_divider"
          android:layout_marginTop="12dp"
          android:layout_marginBottom="12dp"/>

      <!-- Gap Row -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_margin"
            android:tint="?android:attr/textColorSecondary"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pref_suggestion_tool_gap_title"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"/>

        <TextView
            android:id="@+id/tv_gap_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorAccent"/>
      </LinearLayout>

      <!-- Gap SeekBar (0dp to 20dp) -->
      <SeekBar
          android:id="@+id/seekbar_gap"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="4dp"
          android:max="20"
          android:progress="8"/>

    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <!-- Live Toolbar Preview Card -->
  <androidx.cardview.widget.CardView
      android:id="@+id/card_tools_preview"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:cardCornerRadius="20dp"
      app:cardElevation="0dp"
      app:cardBackgroundColor="@color/settings_card_bg"
      android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/pref_suggestion_preview_title"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="?android:attr/textColorSecondary"
          android:layout_marginBottom="8dp"
          android:textAllCaps="true"/>

      <!-- Simulated keyboard toolbar bar -->
      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="44dp"
          android:background="@drawable/bg_settings_input_box"
          android:paddingStart="4dp"
          android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

          <ImageView
              android:id="@+id/preview_menu_button"
              android:layout_width="32dp"
              android:layout_height="match_parent"
              android:src="@drawable/ic_grid_menu"
              android:tint="?android:attr/textColorPrimary"
              android:scaleType="fitCenter"
              android:padding="6dp"/>

          <HorizontalScrollView
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:scrollbars="none">

            <LinearLayout
                android:id="@+id/preview_tools_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
          </HorizontalScrollView>

          <ImageView
              android:id="@+id/preview_voice_button"
              android:layout_width="28dp"
              android:layout_height="28dp"
              android:layout_marginStart="4dp"
              android:src="@drawable/ic_mic"
              android:tint="?android:attr/textColorPrimary"
              android:background="@drawable/bg_voice_mic_circle"
              android:scaleType="fitCenter"
              android:padding="5dp"/>
        </LinearLayout>
      </FrameLayout>
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <!-- Category Header: Active Tools -->
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/pref_category_tools_items"
      android:textSize="13sp"
      android:textStyle="bold"
      android:textColor="?attr/colorAccent"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:layout_marginBottom="8dp"/>

  <!-- Info / Tip banner -->
  <TextView
      android:id="@+id/tools_info_tip"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/pref_suggestion_tools_tip"
      android:textSize="13sp"
      android:textColor="?android:attr/textColorSecondary"
      android:lineSpacingMultiplier="1.2"
      android:layout_marginBottom="12dp"/>

  <!-- Card container for the tools list -->
  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:cardCornerRadius="20dp"
      app:cardElevation="0dp"
      app:cardBackgroundColor="@color/settings_card_bg"
      android:layout_marginBottom="12dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tools_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"/>
  </androidx.cardview.widget.CardView>

  <!-- Action buttons below card -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center"
      android:layout_marginTop="4dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_tasker_tool"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:icon="@drawable/ic_tasker_bolt"
        app:iconPadding="6dp"
        app:iconSize="18dp"
        android:text="@string/pref_add_tasker_tool"
        android:textSize="13sp"
        android:textAllCaps="false"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reset_tools"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pref_suggestion_tools_reset"
        android:textSize="13sp"
        android:textAllCaps="false"/>
  </LinearLayout>

</LinearLayout>
