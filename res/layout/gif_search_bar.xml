<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gif_search_bar"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/colorKeyboard"
    android:paddingStart="6dp"
    android:paddingEnd="8dp">

  <!-- Back button to return to GIF pane -->
  <ImageButton
      android:id="@+id/btn_gif_search_back"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:src="@drawable/ic_arrow_back"
      android:scaleType="fitCenter"
      android:padding="8dp"
      android:tint="?attr/colorLabel"
      android:contentDescription="Back" />

  <!-- Search pill container -->
  <LinearLayout
      android:id="@+id/gif_search_bar_container"
      android:layout_width="0dp"
      android:layout_height="32dp"
      android:layout_weight="1"
      android:layout_marginStart="4dp"
      android:layout_marginEnd="6dp"
      android:background="@drawable/bg_gif_search_box"
      android:gravity="center_vertical"
      android:paddingStart="10dp"
      android:paddingEnd="6dp"
      android:orientation="horizontal">

    <ImageView
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_search"
        android:tint="?attr/colorSubLabel" />

    <TextView
        android:id="@+id/tv_gif_search_query"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:hint="Search GIFs..."
        android:textColorHint="?attr/colorSubLabel"
        android:textColor="?attr/colorLabel"
        android:textSize="14sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <ImageButton
        android:id="@+id/btn_gif_search_clear"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:scaleType="fitCenter"
        android:padding="4dp"
        android:tint="?attr/colorSubLabel"
        android:visibility="gone"
        android:contentDescription="Clear" />
  </LinearLayout>

  <!-- Submit Search Action Button -->
  <Button
      android:id="@+id/btn_gif_search_submit"
      android:layout_width="wrap_content"
      android:layout_height="32dp"
      android:minWidth="62dp"
      android:text="Search"
      android:textSize="12sp"
      android:textColor="#FFFFFF"
      android:textStyle="bold"
      android:background="@drawable/bg_gif_pill_active"
      android:paddingStart="12dp"
      android:paddingEnd="12dp" />

</LinearLayout>
