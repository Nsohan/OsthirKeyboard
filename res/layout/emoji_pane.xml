      android:id="@+id/emoji_group_bar"
      android:orientation="horizontal"
      android:layout_width="match_parent"
      android:layout_height="@dimen/emoji_category_bar_height"
      android:background="?attr/emoji_button_bg"/>
  <com.nhs.customkeyboard.EmojiGridView android:id="@+id/emoji_grid" android:layout_width="fill_parent" android:layout_height="@dimen/emoji_grid_height" android:orientation="vertical" android:numColumns="auto_fit" android:columnWidth="45sp" android:background="?attr/colorKeyboard"/>
