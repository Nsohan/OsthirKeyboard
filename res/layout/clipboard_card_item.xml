<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp">

  <LinearLayout
      android:id="@+id/card_container"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_clipboard_card"
      android:paddingStart="12dp"
      android:paddingEnd="12dp"
      android:paddingTop="10dp"
      android:paddingBottom="10dp"
      android:clickable="true"
      android:focusable="true">

    <TextView
        android:id="@+id/card_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorSubLabel"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="3dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/card_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorLabel"
        android:textSize="14sp"
        android:maxLines="6"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"/>
  </LinearLayout>

  <ImageView
      android:id="@+id/card_select_indicator"
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:layout_gravity="top|end"
      android:layout_margin="6dp"
      android:src="@drawable/ic_check"
      android:background="@drawable/bg_circle_close"
      android:padding="3dp"
      android:tint="?attr/colorLabel"
      android:visibility="gone"/>

</FrameLayout>
