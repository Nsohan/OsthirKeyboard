<?xml version="1.0" encoding="utf-8"?>
<com.nhs.customkeyboard.gif.GifManagerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gif_pane_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorKeyboard">

  <!-- Top Bar: Fixed Back, Scrollable [Search + Recents + Chips], Fixed More -->
  <LinearLayout
      android:id="@+id/gif_top_bar"
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="4dp"
      android:paddingEnd="4dp">

    <!-- Fixed Back Arrow -->
    <ImageButton
        android:id="@+id/gif_btn_back"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_back"
        android:tint="?attr/colorLabel"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="Back" />

    <!-- Unified Horizontal Scroll: [Search Box, Recents Button, Category Chips] -->
    <HorizontalScrollView
        android:id="@+id/gif_chips_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingStart="4dp"
          android:paddingEnd="4dp">

        <!-- Search Input Box (Scrolls with chips under fixed Back button) -->
        <LinearLayout
            android:id="@+id/gif_search_container"
            android:layout_width="130dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_gif_search_box"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

          <ImageView
              android:layout_width="15dp"
              android:layout_height="15dp"
              android:src="@drawable/ic_search"
              android:tint="?attr/colorSubLabel" />

          <TextView
              android:id="@+id/gif_search_input"
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:layout_marginStart="4dp"
              android:background="@null"
              android:gravity="center_vertical"
              android:hint="Search"
              android:textColorHint="?attr/colorSubLabel"
              android:textColor="?attr/colorLabel"
              android:textSize="13sp"
              android:singleLine="true"
              android:ellipsize="end" />

          <ImageView
              android:id="@+id/gif_search_clear"
              android:layout_width="18dp"
              android:layout_height="18dp"
              android:src="@drawable/ic_close"
              android:tint="?attr/colorSubLabel"
              android:visibility="gone"
              android:clickable="true"
              android:focusable="true" />
        </LinearLayout>

        <!-- Recents Clock Button (Scrolls with chips) -->
        <ImageButton
            android:id="@+id/gif_btn_recents"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_clock_recent"
            android:tint="?attr/colorSubLabel"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="Recent" />

        <!-- Category / Reaction Chips Container -->
        <LinearLayout
            android:id="@+id/gif_chips_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

      </LinearLayout>
    </HorizontalScrollView>

    <!-- Fixed 3-Dots More Options -->
    <ImageButton
        android:id="@+id/gif_btn_more"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert"
        android:tint="?attr/colorSubLabel"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="More" />
  </LinearLayout>

  <!-- GIF Grid Content Area -->
  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gif_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <ProgressBar
        android:id="@+id/gif_loading_spinner"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/gif_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

      <TextView
          android:id="@+id/gif_empty_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="No GIFs found"
          android:textColor="?attr/colorLabel"
          android:textSize="14sp"
          android:gravity="center" />

      <Button
          android:id="@+id/gif_btn_settings"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:layout_marginTop="8dp"
          android:text="GIPHY Settings"
          android:textSize="12sp"
          android:textColor="?attr/colorLabel"
          android:background="@drawable/bg_menu_pill"
          android:paddingStart="12dp"
          android:paddingEnd="12dp" />
    </LinearLayout>
  </FrameLayout>

  <!-- Bottom Media Tab Bar (ABC, Emoji, GIF, Sticker, Emoticon, Backspace) -->
  <LinearLayout
      android:id="@+id/gif_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="46dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:paddingTop="3dp"
      android:paddingBottom="10dp">

    <!-- ABC -->
    <TextView
        android:id="@+id/gif_btn_abc"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="ABC"
        android:textColor="?attr/colorLabel"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <!-- Emoji 🙂 -->
    <ImageButton
        android:id="@+id/gif_btn_emoji"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/ic_emoji_menu"
        android:tint="?attr/colorLabel"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="Emoji" />

    <!-- GIF (Active Highlighted Tab) -->
    <FrameLayout
        android:id="@+id/gif_btn_gif_tab"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_weight="1.2"
        android:background="@drawable/bg_gif_pill_active"
        android:clickable="true"
        android:focusable="true">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:text="GIF"
          android:textColor="#1A1A1A"
          android:textSize="14sp"
          android:textStyle="bold" />
    </FrameLayout>

    <!-- Sticker -->
    <ImageButton
        android:id="@+id/gif_btn_sticker"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/ic_sticker"
        android:tint="?attr/colorLabel"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="Stickers" />

    <!-- Emoticon :-) -->
    <ImageButton
        android:id="@+id/gif_btn_emoticon"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/ic_emoticon"
        android:tint="?attr/colorLabel"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="Emoticons" />

    <!-- Backspace -->
    <ImageButton
        android:id="@+id/gif_btn_backspace"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/ic_tool_backspace"
        android:tint="?attr/colorLabel"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="Backspace" />
  </LinearLayout>

</com.nhs.customkeyboard.gif.GifManagerView>
