<?xml version="1.0" encoding="utf-8"?>
<com.nhs.customkeyboard.ClipboardManagerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clipboard_manager_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

  <!-- Top Header Bar -->
  <RelativeLayout
      android:id="@+id/clipboard_header_bar"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:paddingStart="8dp"
      android:paddingEnd="12dp"
      android:gravity="center_vertical">

    <!-- Circle Back Button -->
    <ImageButton
        android:id="@+id/clipboard_btn_back"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_circle_button"
        android:src="@drawable/ic_arrow_back"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:tint="?attr/colorLabel"
        android:contentDescription="Back"/>

    <!-- Title: Clipboard -->
    <TextView
        android:id="@+id/clipboard_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/clipboard_btn_back"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:text="@string/clipboard_history_heading"
        android:textColor="?attr/colorLabel"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"/>

    <!-- Right Container: Switch & Edit Button -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <!-- History toggle switch -->
      <Switch
          android:id="@+id/clipboard_switch_toggle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="8dp"/>

      <!-- Edit / Pencil Button -->
      <ImageButton
          android:id="@+id/clipboard_btn_edit"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_edit_pencil"
          android:padding="7dp"
          android:scaleType="fitCenter"
          android:tint="?attr/colorLabel"
          android:contentDescription="Edit"/>

      <!-- Delete selected button (visible in edit mode) -->
      <ImageButton
          android:id="@+id/clipboard_btn_delete_selected"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete"
          android:padding="7dp"
          android:scaleType="fitCenter"
          android:tint="?attr/colorLabel"
          android:visibility="gone"
          android:contentDescription="Delete Selected"/>
    </LinearLayout>
  </RelativeLayout>

  <!-- Middle: RecyclerView with StaggeredGrid (2 columns) -->
  <FrameLayout
      android:id="@+id/clipboard_content_container"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/clipboard_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

    <!-- Empty state view -->
    <LinearLayout
        android:id="@+id/clipboard_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:visibility="gone">

      <ImageView
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:src="@drawable/ic_tool_clipboard"
          android:tint="?attr/colorLabel"
          android:alpha="0.4"/>

      <TextView
          android:id="@+id/clipboard_empty_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="No copied items yet"
          android:textColor="?attr/colorLabel"
          android:alpha="0.6"
          android:textSize="14sp"/>
    </LinearLayout>
  </FrameLayout>

</com.nhs.customkeyboard.ClipboardManagerView>
